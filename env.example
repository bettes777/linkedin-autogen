# Copy to .env and fill in. Never commit .env (it holds your key).

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource-or-gateway.example.com/
AZURE_OPENAI_API_VERSION=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_MODEL=gpt-5-mini

# --- Service behaviour ---
# true = no Azure calls; returns a fixed sample post (for wiring and testing n8n)
MOCK_MODE=false
# Seconds before the whole 4-agent chain is aborted (n8n HTTP timeout should be higher)
LLM_TIMEOUT_SEC=120
# Pause between agent calls (light rate limiting)
RATE_SLEEP_SEC=0.5
# Where runs.jsonl and run_log.csv are written
LOG_DIR=logs
